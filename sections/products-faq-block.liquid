<div class="product-faqs-section page-width page-width-desktop">
  {% assign product_faqs = product.metafields.custom.faq.value %}

  {% if product_faqs != blank %}
    <h2 class="product-faqs-heading">
      {{ section.settings.heading | escape }}
    </h2>

    <div class="product-faqs-list">
      {% for faq in product_faqs %}
        <details class="product-faq-item">
          <summary class="product-faq-question">
            <span>{{ faq.faq_question.value | escape }}</span>

            <svg
              class="product-faq-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>

          <div class="product-faq-answer rte">
            {{ faq.faq_ans | metafield_tag }}
          </div>
        </details>
      {% endfor %}
    </div>
  {% endif %}
</div>

<style>
  .product-faqs-section {
    padding-top: 40px;
    padding-bottom: 40px;
  }

  .product-faqs-heading {
    margin-bottom: 24px;
  }

  .product-faq-item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.15);
  }

  .product-faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    padding: 18px 0;
    font-weight: 600;
    list-style: none;
  }

  .product-faq-question::-webkit-details-marker {
    display: none;
  }

  .product-faq-question::marker {
    content: "";
  }

  .product-faq-icon {
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .product-faq-item[open] .product-faq-icon {
    transform: rotate(180deg);
  }

  .product-faq-answer {
    padding: 0 0 18px;
  }
</style>

{% schema %}
  {
    "name": "Product FAQs",
    "tag": "section",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Frequently Asked Questions"
      }
    ],
    "presets": [
      {
        "name": "Product FAQs"
      }
    ]
  }
{% endschema %}